# Copy to .env.local and fill in. Never commit real values. `npm run dev` / `npm run start` load .env.local
# automatically; the scripts (npm run eval, npm run seed, ...) load it themselves.
# Server-only: do NOT prefix any of these with NEXT_PUBLIC_. On Railway set the same names as service variables
# (see README.md, "Deploy on Railway").

# OpenRouter API key (sk-or-...), server only; read only by src/lib/extract.ts. Set a credit limit on the key in
# the OpenRouter dashboard. Without a key every run is held: "LLM provider unavailable (billing/auth)".
OPENROUTER_API_KEY=
# OpenRouter slug for the primary extraction model (verified 2026-11, IMPLEMENTATION_PLAN.md section 5)
EXTRACT_MODEL=google/gemini-3.8-flash
# OpenRouter slug for the fallback model (different provider family)
FALLBACK_MODEL=anthropic/claude-haiku-5.5
# SQLite file at $DATA_DIR/app.db, uploads at $DATA_DIR/uploads (relative paths start at the project root).
# On Railway mount the volume at /app/storage and set DATA_DIR=/app/storage (never /app/data: that would hide
# data/seed and data/samples, which the app reads from <project root>/data).
DATA_DIR=./data
# "true" enables POST /api/reset (the "Reset demo data" button); anything else disables it
DEMO_RESET_ENABLED=true
# Random string of at least 16 characters (shorter counts as unset); required in the x-reset-token header
DEMO_RESET_TOKEN=
# Global cap on runs started per rolling hour, to protect API credit on a public URL (default 60)
MAX_RUNS_PER_HOUR=60
# Offline mock extractor that returns the samples' truth JSON ("1"), or a fooled model for sample 9 ("fooled").
# For development without a key only. Never set it in production: runs then show model "mock".
# EXTRACT_MOCK=1
# Port for `npm run dev` / `npm run start` (Next.js default 3000; Railway injects PORT itself)
# PORT=3000
