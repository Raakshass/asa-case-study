# Copy to .env.local and fill in. Never commit real values.
# Server-only: do NOT prefix any of these with NEXT_PUBLIC_.

# OpenRouter API key (sk-or-...), server only
OPENROUTER_API_KEY=
# OpenRouter slug for the primary extraction model (verified 2026-11, IMPLEMENTATION_PLAN.md section 5)
EXTRACT_MODEL=google/gemini-3.8-flash
# OpenRouter slug for the fallback model (different provider family)
FALLBACK_MODEL=anthropic/claude-haiku-5.5
# SQLite file at $DATA_DIR/app.db, uploads at $DATA_DIR/uploads.
# On Railway mount the volume outside /app/data (e.g. /app/storage) and point DATA_DIR there.
DATA_DIR=./data
DEMO_RESET_ENABLED=true
# Random string (at least 16 characters); required in the x-reset-token header for /api/reset
DEMO_RESET_TOKEN=
# Global cap to protect API credit on a public URL
MAX_RUNS_PER_HOUR=60
# Offline truth-JSON mock extractor for builds without a key ("1", or "fooled" to simulate a fooled model).
# Never set in production: runs then show model "mock".
# EXTRACT_MOCK=1
