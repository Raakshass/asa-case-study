# Copy to .env.local and fill in. Never commit real values.
# Server-only: do NOT prefix any of these with NEXT_PUBLIC_.

# OpenRouter API key (sk-or-...), server only
OPENROUTER_API_KEY=
# OpenRouter slug for the primary extraction model
EXTRACT_MODEL=
# OpenRouter slug for the fallback model
FALLBACK_MODEL=
# SQLite file at $DATA_DIR/app.db, uploads at $DATA_DIR/uploads (use /app/data on Railway)
DATA_DIR=./data
DEMO_RESET_ENABLED=true
# Random string; required in the x-reset-token header for /api/reset
DEMO_RESET_TOKEN=
# Global cap to protect API credit on a public URL
MAX_RUNS_PER_HOUR=60
